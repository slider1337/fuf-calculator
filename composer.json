{
  "name": "fuf/calculator",
  "description": "FUF Gruppenreise Kalkulator",
  "type": "project",
  "require": {
    "php": "^8.4",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "zircote/swagger-php": "^5.0",
    "twbs/bootstrap": "^5.3",
    "ext-pdo": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php scripts/copy-bootstrap.php",
      "@php scripts/copy-swagger-ui.php"
    ],
    "post-update-cmd": [
      "@php scripts/copy-bootstrap.php",
      "@php scripts/copy-swagger-ui.php"
    ],
    "test": "phpunit --configuration phpunit.xml",
    "test:coverage": "phpunit --configuration phpunit.xml --coverage-text --coverage-clover build/logs/clover.xml"
  }
}



