{
  "name": "fuf/calculator",
  "description": "FUF Gruppenreise Kalkulator",
  "type": "project",
  "require": {
    "php": "^8.4",
    "slim/slim": "^4.15.3",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "zircote/swagger-php": "^6.15",
    "twbs/bootstrap": "^5.3",
    "symfony/mailer": "^7.4",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "robmorgan/phinx": "^0.16.12",
    "jumbojett/openid-connect-php": "^1.0",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php scripts/patch-openid-nullability.php",
      "@php scripts/copy-bootstrap.php",
      "@php scripts/copy-swagger-ui.php"
    ],
    "post-update-cmd": [
      "@php scripts/patch-openid-nullability.php",
      "@php scripts/copy-bootstrap.php",
      "@php scripts/copy-swagger-ui.php"
    ],
    "test": "phpunit --configuration phpunit.xml",
    "test:coverage": "phpunit --configuration phpunit.xml --coverage-text --coverage-clover build/logs/clover.xml",
    "migrate": "@php scripts/migrate.php",
    "analyse": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G"
  },
  "conflict": {
    "symfony/config": "8.0.*",
    "symfony/console": "8.0.*",
    "symfony/event-dispatcher": "8.0.*",
    "symfony/filesystem": "8.0.*",
    "symfony/finder": "8.0.*",
    "symfony/mime": "8.0.*",
    "symfony/string": "8.0.*",
    "symfony/yaml": "8.0.*"
  }
}
